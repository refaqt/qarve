# Text
* text=auto

# Shell files must never be stored with Windows line endings. A script that
# arrives that way fails with "bad interpreter". Naming each file one by one
# missed .claude/hooks/session-start.sh, so this covers every shell file.
*.sh text eol=lf

# Git LFS — configure before first binary CAD commit
*.FCStd filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
